{
  "name": "default",
  "video": {
    "format": "horizontal",
    "fps": 30,
    "width": null,
    "height": null
  },
  "background": {
    "type": "solid",
    "color": "#d4e8f5",
    "gradient": "linear-gradient(180deg, #dbeefa 0%, #c9e1f2 100%)",
    "src": null,
    "overlay": null,
    "blur": 0,
    "panel": null
  },
  "fonts": {
    "text": {
      "family": "Zen Maru Gothic",
      "weights": [
        500,
        700
      ]
    },
    "translation": {
      "family": "Delius",
      "weights": [
        400
      ]
    },
    "emoji": "Noto Color Emoji"
  },
  "layout": {
    "paddingX": 225,
    "top": 70,
    "bottom": 70,
    "cardGap": 90,
    "characterInset": 190,
    "linesPerSlide": 2
  },
  "card": {
    "background": "#ffffff",
    "border": "5px solid #111111",
    "radius": 46,
    "shadow": {
      "x": 12,
      "y": 14,
      "color": "#111111"
    },
    "paddingX": 85,
    "characterSidePadding": 190,
    "paddingY": 40,
    "minHeight": 256,
    "align": "auto",
    "textSize": 82,
    "textWeight": 500,
    "textColor": "#111111",
    "translationSize": 50,
    "translationColor": "#111111",
    "translationFormat": "({t})",
    "entrance": "grow",
    "textReveal": "fade",
    "typewriterSpeed": 0.08
  },
  "character": {
    "height": 340,
    "offsetX": 80,
    "offsetY": 0,
    "entrance": "pop",
    "fit": "contain",
    "speed": 1
  },
  "characters": {},
  "timing": {
    "startDelay": 0.8,
    "characterLead": 0.6,
    "textDelay": 0.35,
    "audioDelay": 0.25,
    "answerDelay": 1.5,
    "slideHold": 1.5,
    "slideGap": 0.3,
    "endHold": 2,
    "secondsPerChar": 0.25,
    "minLine": 1.5
  },
  "audio": {
    "japaneseRepeat": 3,
    "englishRepeat": 1,
    "order": "english-first",
    "repeatGap": 0.7,
    "languageGap": 1
  },
  "transition": {
    "out": "shrink",
    "duration": 0.5,
    "stagger": 0.1,
    "outroLast": true
  },
  "sounds": {
    "cardIn": null,
    "characterIn": "sounds/received.wav",
    "volume": 0.35,
    "voiceVolume": 1
  },
  "music": {
    "src": null,
    "volume": 0.15
  }
